{% comment %}
  FlexyPlay — Cart page section
  Same look as the homepage/product sections. Works without JS (quantity and
  remove links hit /cart/change and reload the page); with JS the change is
  sent to /cart/change.js and only the cart body is re-rendered through the
  Section Rendering API.
{% endcomment %}
{% render 'flexyplay-styles' %}

{%- liquid
  assign gradients = 'linear-gradient(150deg,#FFD166,#FF9E4F,#FF6B5E)|linear-gradient(150deg,#2EC4B6,#33b98f,#4bb96a)|linear-gradient(150deg,#FF6B5E,#ff5470,#ff8566)|linear-gradient(150deg,#FFD166,#e8b06a,#d69456)|linear-gradient(150deg,#8a5a3c,#a56b45,#c08856)|linear-gradient(150deg,#b98a5a,#caa06e,#e0bd8a)' | split: '|'
-%}

<style>
  .fp-cart-page { padding: 140px 24px 80px; max-width: 1160px; margin: 0 auto; min-height: 70vh; }
  .fp-cart-head { display: flex; align-items: baseline; gap: 14px; flex-wrap: wrap; margin-bottom: 30px; }
  .fp-cart-head h1 { font-family: 'Baloo 2', cursive; font-weight: 800; font-size: 46px; line-height: 1; margin: 0; }
  .fp-cart-head span { font-weight: 700; color: #6b5348; font-size: 17px; }
  .fp-cart-grid { display: grid; grid-template-columns: 1.6fr 1fr; gap: 28px; align-items: start; }
  .fp-cart-items { display: flex; flex-direction: column; gap: 16px; }
  .fp-cart-item { display: grid; grid-template-columns: 104px 1fr auto; gap: 20px; align-items: center; background: #fff; border: 2px solid #f0e2d2; border-radius: 26px; padding: 16px 20px 16px 16px; box-shadow: 0 10px 22px rgba(67,43,33,.06); }
  .fp-cart-thumb { width: 104px; height: 104px; border-radius: 20px; display: flex; align-items: center; justify-content: center; font-size: 36px; letter-spacing: -4px; white-space: nowrap; overflow: hidden; }
  .fp-cart-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .fp-cart-info h3 { font-family: 'Baloo 2', cursive; font-weight: 700; font-size: 20px; margin: 0 0 2px; line-height: 1.2; }
  .fp-root .fp-cart-info h3 a { color: #432B21; }
  .fp-cart-variant { font-size: 14px; color: #6b5348; font-weight: 700; margin: 0 0 4px; }
  .fp-cart-unit { font-size: 14px; color: #6b5348; margin: 0 0 12px; }
  .fp-cart-controls { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
  .fp-qty { display: inline-flex; align-items: center; background: #FFF6EC; border: 2px solid #efdcc7; border-radius: 999px; }
  .fp-root .fp-qty a { width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; font-family: 'Baloo 2', cursive; font-weight: 800; font-size: 20px; color: #432B21; border-radius: 50%; }
  .fp-root .fp-qty a:hover { color: #FF6B5E; }
  .fp-qty span { min-width: 30px; text-align: center; font-family: 'Baloo 2', cursive; font-weight: 800; font-size: 17px; }
  .fp-root a.fp-cart-remove { font-size: 14px; font-weight: 700; color: #9a8377; text-decoration: underline; text-underline-offset: 3px; }
  .fp-root a.fp-cart-remove:hover { color: #d94a3d; }
  .fp-cart-line { text-align: right; }
  .fp-cart-line strong { display: block; font-family: 'Baloo 2', cursive; font-weight: 800; font-size: 24px; }
  .fp-cart-line s { font-size: 14px; color: #b09a8c; }
  .fp-cart-summary { position: sticky; top: 120px; background: #fff; border: 2px solid #f0e2d2; border-radius: 28px; padding: 26px; box-shadow: 0 14px 30px rgba(67,43,33,.07); }
  .fp-cart-summary h2 { font-family: 'Baloo 2', cursive; font-weight: 800; font-size: 24px; margin: 0 0 18px; }
  .fp-cart-row { display: flex; justify-content: space-between; gap: 12px; font-size: 16px; margin-bottom: 10px; }
  .fp-cart-row.fp-cart-discount { color: #2a9d8f; font-weight: 700; }
  .fp-cart-total { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; border-top: 2px dashed #f0e2d2; padding-top: 16px; margin: 16px 0 6px; }
  .fp-cart-total span { font-weight: 800; font-size: 17px; }
  .fp-cart-total strong { font-family: 'Baloo 2', cursive; font-weight: 800; font-size: 32px; }
  .fp-cart-note { font-size: 13px; color: #6b5348; margin: 0 0 20px; }
  .fp-checkout-btn { width: 100%; display: block; background: #FF6B5E; color: #fff; font-family: 'Baloo 2', cursive; font-weight: 800; font-size: 19px; padding: 16px; border-radius: 18px; box-shadow: 0 7px 0 #d94a3d; }
  .fp-root a.fp-cart-continue { display: block; text-align: center; margin-top: 18px; font-weight: 800; font-size: 15px; color: #432B21; }
  .fp-root a.fp-cart-continue:hover { color: #FF6B5E; }
  .fp-cart-perks { list-style: none; margin: 22px 0 0; padding: 18px 0 0; border-top: 2px solid #f6ece1; display: flex; flex-direction: column; gap: 10px; font-size: 14px; color: #6b5348; font-weight: 700; }
  .fp-cart-empty { text-align: center; background: #fff; border: 2px solid #f0e2d2; border-radius: 32px; padding: 60px 24px; box-shadow: 0 14px 30px rgba(67,43,33,.07); max-width: 640px; margin: 0 auto; }
  .fp-cart-empty-emoji { font-size: 72px; margin-bottom: 10px; animation: fp-float-sm 5s ease-in-out infinite; }
  .fp-cart-empty h2 { font-family: 'Baloo 2', cursive; font-weight: 800; font-size: 34px; margin: 0 0 8px; }
  .fp-cart-empty p { font-size: 17px; color: #6b5348; margin: 0 0 28px; }
  .fp-root a.fp-cart-empty-btn { display: inline-block; background: #FF6B5E; color: #fff; font-family: 'Baloo 2', cursive; font-weight: 700; font-size: 18px; padding: 15px 30px; border-radius: 18px; box-shadow: 0 8px 0 #d94a3d; }
  [data-fp-cart-body] { transition: opacity .2s ease; }
  [data-fp-cart-body].fp-cart-busy { opacity: .55; pointer-events: none; }
  @media (max-width: 900px) {
    .fp-cart-grid { grid-template-columns: 1fr; }
    .fp-cart-summary { position: static; }
  }
  @media (max-width: 600px) {
    .fp-cart-page { padding: 120px 16px 60px; }
    .fp-cart-head h1 { font-size: 36px; }
    .fp-cart-item { grid-template-columns: 76px 1fr; gap: 14px; padding: 14px; }
    .fp-cart-thumb { width: 76px; height: 76px; font-size: 26px; border-radius: 16px; }
    .fp-cart-line { grid-column: 1 / -1; display: flex; justify-content: space-between; align-items: baseline; text-align: left; border-top: 2px dashed #f6ece1; padding-top: 10px; }
    .fp-cart-line strong { font-size: 21px; }
  }
</style>

<div class="fp-root" id="fp-cart-{{ section.id }}">

  <!-- NAV -->
  <nav class="fp-nav">
    {%- if section.settings.logo_image != blank -%}
      <a href="{{ routes.root_url }}" class="fp-logo"><img src="{{ section.settings.logo_image | image_url: width: 200 }}" alt="{{ shop.name }}"></a>
    {%- else -%}
      <a href="{{ routes.root_url }}" class="fp-logo">{{ section.settings.brand_name | default: shop.name }}</a>
    {%- endif -%}
    <div class="fp-nav-links">
      <a href="{{ routes.root_url }}#produse">Produse</a>
      <a href="{{ routes.root_url }}#faq">Întrebări</a>
      <a href="{{ routes.root_url }}#produse" class="fp-btn3d" style="background:#FF6B5E;color:#fff;font-family:'Baloo 2',cursive;font-weight:700;font-size:15px;padding:11px 20px;border-radius:16px;box-shadow:0 6px 0 #d94a3d;">Vezi colecția</a>
      <a href="{{ routes.cart_url }}" class="fp-cart" aria-label="Coș de cumpărături">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 7h12l-1 13H7L6 7z"/><path d="M9 7a3 3 0 0 1 6 0"/></svg>
        {%- if cart.item_count > 0 -%}<span class="fp-cart-count">{{ cart.item_count }}</span>{%- endif -%}
      </a>
    </div>
  </nav>

  <main class="fp-cart-page" data-fp-cart-body>
    {%- if cart.item_count == 0 -%}
      <div class="fp-cart-empty">
        <div class="fp-cart-empty-emoji" aria-hidden="true">🧸</div>
        <h2>{{ section.settings.empty_heading }}</h2>
        <p>{{ section.settings.empty_text }}</p>
        <a href="{{ routes.root_url }}#produse" class="fp-btn3d fp-cart-empty-btn">Descoperă colecția</a>
      </div>
    {%- else -%}
      <div class="fp-cart-head">
        <h1>{{ section.settings.heading }}</h1>
        <span>{{ cart.item_count }} {% if cart.item_count == 1 %}produs{% else %}produse{% endif %}</span>
      </div>

      <div class="fp-cart-grid">
        <div class="fp-cart-items">
          {%- for item in cart.items -%}
            {%- assign gi = forloop.index0 | modulo: 6 -%}
            {%- assign emoji = item.product.metafields.custom.emoji.value | default: '🧸' -%}
            <div class="fp-cart-item">
              <a href="{{ item.url }}" class="fp-cart-thumb" style="background:{{ gradients[gi] }};">
                {%- if item.image -%}
                  <img src="{{ item.image | image_url: width: 220 }}" alt="{{ item.image.alt | default: item.product.title | escape }}" width="104" height="104" loading="lazy">
                {%- else -%}
                  <span aria-hidden="true">{{ emoji }}</span>
                {%- endif -%}
              </a>
              <div class="fp-cart-info">
                <h3><a href="{{ item.url }}">{{ item.product.title }}</a></h3>
                {%- unless item.product.has_only_default_variant -%}
                  <p class="fp-cart-variant">{{ item.variant.title }}</p>
                {%- endunless -%}
                <p class="fp-cart-unit">{{ item.final_price | money }} / bucată</p>
                <div class="fp-cart-controls">
                  <div class="fp-qty">
                    <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity={{ item.quantity | minus: 1 }}" data-fp-qty data-line="{{ forloop.index }}" data-qty="{{ item.quantity | minus: 1 }}" aria-label="Scade cantitatea">−</a>
                    <span aria-label="Cantitate">{{ item.quantity }}</span>
                    <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity={{ item.quantity | plus: 1 }}" data-fp-qty data-line="{{ forloop.index }}" data-qty="{{ item.quantity | plus: 1 }}" aria-label="Crește cantitatea">+</a>
                  </div>
                  <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity=0" class="fp-cart-remove" data-fp-qty data-line="{{ forloop.index }}" data-qty="0">Șterge</a>
                </div>
              </div>
              <div class="fp-cart-line">
                {%- if item.original_line_price > item.final_line_price -%}<s>{{ item.original_line_price | money }}</s>{%- endif -%}
                <strong>{{ item.final_line_price | money }}</strong>
              </div>
            </div>
          {%- endfor -%}
        </div>

        <aside class="fp-cart-summary">
          <h2>Sumar comandă</h2>
          <div class="fp-cart-row"><span>Produse ({{ cart.item_count }})</span><span>{{ cart.items_subtotal_price | money }}</span></div>
          {%- for discount in cart.cart_level_discount_applications -%}
            <div class="fp-cart-row fp-cart-discount"><span>{{ discount.title }}</span><span>−{{ discount.total_allocated_amount | money }}</span></div>
          {%- endfor -%}
          <div class="fp-cart-row"><span>Livrare</span><span>la pasul următor</span></div>
          <div class="fp-cart-total"><span>Total</span><strong>{{ cart.total_price | money }}</strong></div>
          <p class="fp-cart-note">{{ section.settings.shipping_note }}</p>
          <form action="{{ routes.cart_url }}" method="post">
            <button type="submit" name="checkout" class="fp-btn3d fp-checkout-btn">Finalizează comanda</button>
          </form>
          <a href="{{ routes.root_url }}#produse" class="fp-cart-continue">← Continuă cumpărăturile</a>
          <ul class="fp-cart-perks">
            <li>🚚 Livrare 2–4 zile în toată țara</li>
            <li>↩️ Retur în 14 zile</li>
            <li>🎁 Ambalat cadou, gata de dăruit</li>
          </ul>
        </aside>
      </div>
    {%- endif -%}
  </main>

  <!-- FOOTER -->
  <footer class="fp-footer" style="background:#2a1a13;color:#FFF6EC;padding:40px 24px 30px;">
    <div style="max-width:1160px;margin:0 auto;display:flex;flex-wrap:wrap;gap:12px 40px;justify-content:space-between;align-items:center;font-size:14px;">
      <span style="font-family:'Baloo 2',cursive;font-weight:800;font-size:24px;color:#fff;">{{ section.settings.brand_name | default: shop.name }}</span>
      <span style="color:#c9b3a6;">{{ section.settings.footer_tagline }}</span>
      <span style="color:#9a8377;">© {{ 'now' | date: '%Y' }} {{ section.settings.brand_name | default: shop.name }}</span>
    </div>
  </footer>
</div>

<script>
  (function () {
    var root = document.getElementById('fp-cart-{{ section.id }}');
    if (!root || !window.fetch || !window.DOMParser) return;
    var sectionId = '{{ section.id }}';

    function refresh(itemCount) {
      return fetch('{{ routes.cart_url }}?section_id=' + encodeURIComponent(sectionId))
        .then(function (res) { return res.text(); })
        .then(function (html) {
          var doc = new DOMParser().parseFromString(html, 'text/html');
          var fresh = doc.querySelector('[data-fp-cart-body]');
          var body = root.querySelector('[data-fp-cart-body]');
          if (!fresh || !body) throw new Error('missing cart body');
          body.innerHTML = fresh.innerHTML;
          body.classList.remove('fp-cart-busy');
          if (window.fpUpdateCartCount) window.fpUpdateCartCount(itemCount);
        });
    }

    root.addEventListener('click', function (e) {
      var link = e.target.closest('[data-fp-qty]');
      if (!link) return;
      e.preventDefault();
      root.querySelector('[data-fp-cart-body]').classList.add('fp-cart-busy');
      fetch('{{ routes.cart_change_url }}.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ line: Number(link.dataset.line), quantity: Number(link.dataset.qty) })
      })
        .then(function (res) { if (!res.ok) throw new Error('change failed'); return res.json(); })
        .then(function (cart) { return refresh(cart.item_count); })
        .catch(function () { window.location.href = link.href; });
    });
  })();
</script>

{% schema %}
{
  "name": "FlexyPlay Coș",
  "settings": [
    { "type": "header", "content": "Brand" },
    { "type": "image_picker", "id": "logo_image", "label": "Logo (opțional, gol = wordmark text)" },
    { "type": "text", "id": "brand_name", "label": "Nume brand", "default": "FlexyPlay" },
    { "type": "header", "content": "Coș" },
    { "type": "text", "id": "heading", "label": "Titlu", "default": "Coșul tău" },
    { "type": "text", "id": "shipping_note", "label": "Notă sub total", "default": "Costul livrării și eventualele reduceri se calculează la finalizarea comenzii." },
    { "type": "header", "content": "Coș gol" },
    { "type": "text", "id": "empty_heading", "label": "Titlu coș gol", "default": "Coșul tău e gol" },
    { "type": "text", "id": "empty_text", "label": "Text coș gol", "default": "Hai să-i găsim un prieten flexi!" },
    { "type": "header", "content": "Footer" },
    { "type": "text", "id": "footer_tagline", "label": "Descriere brand", "default": "Jucării flexi articulate, printate 3D cu drag în România." }
  ]
}
{% endschema %}
