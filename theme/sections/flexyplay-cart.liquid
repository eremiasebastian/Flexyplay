{% comment %}
  FlexyPlay — Cart page section
  Same look as the homepage/product sections. Works without JS (quantity and
  remove links hit /cart/change and reload the page); with JS the change is
  sent to /cart/change.js and only the cart body is re-rendered through the
  Section Rendering API.
{% endcomment %}
{% render 'flexyplay-styles' %}

{%- liquid
  assign gradients = 'linear-gradient(150deg,#FFD166,#FF9E4F,#FF6B5E)|linear-gradient(150deg,#2EC4B6,#33b98f,#4bb96a)|linear-gradient(150deg,#FF6B5E,#ff5470,#ff8566)|linear-gradient(150deg,#FFD166,#e8b06a,#d69456)|linear-gradient(150deg,#8a5a3c,#a56b45,#c08856)|linear-gradient(150deg,#b98a5a,#caa06e,#e0bd8a)' | split: '|'
-%}

<style>
  .fp-cart-page { padding: 140px 24px 80px; max-width: 1160px; margin: 0 auto; min-height: 70vh; }
  .fp-cart-head { display: flex; align-items: baseline; gap: 14px; flex-wrap: wrap; margin-bottom: 30px; }
  .fp-cart-head h1 { font-family: 'Baloo 2', cursive; font-weight: 800; font-size: 46px; line-height: 1; margin: 0; }
  .fp-cart-head span { font-weight: 700; color: #6b5348; font-size: 17px; }
  .fp-cart-grid { display: grid; grid-template-columns: 1.6fr 1fr; gap: 28px; align-items: start; }
  .fp-cart-items { display: flex; flex-direction: column; gap: 16px; }
  .fp-cart-item { display: grid; grid-template-columns: 104px 1fr auto; gap: 20px; align-items: center; background: #fff; border: 2px solid #f0e2d2; border-radius: 26px; padding: 16px 20px 16px 16px; box-shadow: 0 10px 22px rgba(67,43,33,.06); }
  .fp-cart-thumb { width: 104px; height: 104px; border-radius: 20px; display: flex; align-items: center; justify-content: center; font-size: 36px; letter-spacing: -4px; white-space: nowrap; overflow: hidden; }
  .fp-cart-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .fp-cart-info h3 { font-family: 'Baloo 2', cursive; font-weight: 700; font-size: 20px; margin: 0 0 2px; line-height: 1.2; }
  .fp-root .fp-cart-info h3 a { color: #432B21; }
  .fp-cart-variant { font-size: 14px; color: #6b5348; font-weight: 700; margin: 0 0 4px; }
  .fp-cart-unit { font-size: 14px; color: #6b5348; margin: 0 0 12px; }
  .fp-cart-controls { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
  .fp-qty { display: inline-flex; align-items: center; background: #FFF6EC; border: 2px solid #efdcc7; border-radius: 999px; }
  .fp-root .fp-qty a { width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; font-family: 'Baloo 2', cursive; font-weight: 800; font-size: 20px; color: #432B21; border-radius: 50%; }
  .fp-root .fp-qty a:hover { color: #FF6B5E; }
  .fp-qty span { min-width: 30px; text-align: center; font-family: 'Baloo 2', cursive; font-weight: 800; font-size: 17px; }
  .fp-root a.fp-cart-remove { font-size: 14px; font-weight: 700; color: #9a8377; text-decoration: underline; text-underline-offset: 3px; }
  .fp-root a.fp-cart-remove:hover { color: #d94a3d; }
  .fp-cart-line { text-align: right; }
  .fp-cart-line strong { display: block; font-family: 'Baloo 2', cursive; font-weight: 800; font-size: 24px; }
  .fp-cart-line s { font-size: 14px; color: #b09a8c; }
  .fp-cart-summary { position: sticky; top: 120px; background: #fff; border: 2px solid #f0e2d2; border-radius: 28px; padding: 26px; box-shadow: 0 14px 30px rgba(67,43,33,.07); }
  .fp-cart-summary h2 { font-family: 'Baloo 2', cursive; font-weight: 800; font-size: 24px; margin: 0 0 18px; }
  .fp-cart-row { display: flex; justify-content: space-between; gap: 12px; font-size: 16px; margin-bottom: 10px; }
  .fp-cart-row.fp-cart-discount { color: #2a9d8f; font-weight: 700; }
  .fp-cart-total { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; border-top: 2px dashed #f0e2d2; padding-top: 16px; margin: 16px 0 6px; }
  .fp-cart-total span { font-weight: 800; font-size: 17px; }
  .fp-cart-total strong { font-family: 'Baloo 2', cursive; font-weight: 800; font-size: 32px; }
  .fp-cart-note { font-size: 13px; color: #6b5348; margin: 0 0 20px; }
  .fp-checkout-btn { width: 100%; display: block; background: #FF6B5E; color: #fff; font-family: 'Baloo 2', cursive; font-weight: 800; font-size: 19px; padding: 16px; border-radius: 18px; box-shadow: 0 7px 0 #d94a3d; }
  .fp-root a.fp-cart-continue { display: block; text-align: center; margin-top: 18px; font-weight: 800; font-size: 15px; color: #432B21; }
  .fp-root a.fp-cart-continue:hover { color: #FF6B5E; }
  .fp-cart-perks { list-style: none; margin: 22px 0 0; padding: 18px 0 0; border-top: 2px solid #f6ece1; display: flex; flex-direction: column; gap: 10px; font-size: 14px; color: #6b5348; font-weight: 700; }
  .fp-cart-empty { text-align: center; background: #fff; border: 2px solid #f0e2d2; border-radius: 32px; padding: 60px 24px; box-shadow: 0 14px 30px rgba(67,43,33,.07); max-width: 640px; margin: 0 auto; }
  .fp-cart-empty-emoji { font-size: 72px; margin-bottom: 10px; animation: fp-float-sm 5s ease-in-out infinite; }
  .fp-cart-empty h2 { font-family: 'Baloo 2', cursive; font-weight: 800; font-size: 34px; margin: 0 0 8px; }
  .fp-cart-empty p { font-size: 17px; color: #6b5348; margin: 0 0 28px; }
  .fp-root a.fp-cart-empty-btn { display: inline-block; background: #FF6B5E; color: #fff; font-family: 'Baloo 2', cursive; font-weight: 700; font-size: 18px; padding: 15px 30px; border-radius: 18px; box-shadow: 0 8px 0 #d94a3d; }
  .fp-free-ship { background: #fff; border: 2px solid #f0e2d2; border-radius: 20px; padding: 16px 20px; margin-bottom: 22px; }
  .fp-free-ship p { margin: 0 0 10px; font-size: 16px; font-weight: 700; color: #432B21; }
  .fp-free-ship-bar { height: 10px; background: #f6ece1; border-radius: 999px; overflow: hidden; }
  .fp-free-ship-bar span { display: block; height: 100%; border-radius: 999px; background: linear-gradient(90deg, #FFD166, #FF6B5E); transition: width .4s ease; }
  .fp-free-ship-done .fp-free-ship-bar span { background: #2EC4B6; }
  .fp-free-ship-bar { position: relative; }
  .fp-ship { margin: 16px 0 14px; display: grid; gap: 10px; }
  .fp-ship-h { margin: 0; font-family: 'Baloo 2', cursive; font-weight: 800; font-size: 17px; color: #432B21; }
  .fp-ship-opt { display: flex; align-items: center; gap: 12px; padding: 12px 14px; background: #fff; border: 2px solid #f0e2d2; border-radius: 16px; cursor: pointer; transition: border-color .2s ease, box-shadow .2s ease; }
  .fp-ship-opt input { accent-color: #FF6B5E; width: 18px; height: 18px; flex: none; margin: 0; }
  .fp-ship-opt.fp-ship-on { border-color: #FF6B5E; box-shadow: 0 4px 0 #ffd3cd; }
  .fp-ship-t { flex: 1; font-weight: 800; font-size: 15px; color: #432B21; line-height: 1.3; }
  .fp-ship-t small { display: block; font-weight: 600; font-size: 12px; color: #9a8377; }
  .fp-ship-p { font-weight: 800; font-size: 14px; color: #23988d; white-space: nowrap; }
  .fp-ship-point { margin: -2px 0 2px; padding: 12px 14px; background: #fff8f0; border: 2px dashed #f0d9c2; border-radius: 16px; }
  .fp-ship-point p { margin: 0 0 8px; font-size: 14px; font-weight: 700; color: #432B21; line-height: 1.4; }
  .fp-ship-pick { width: 100%; background: #FF6B5E; color: #fff; font-family: 'Baloo 2', cursive; font-weight: 700; font-size: 16px; padding: 11px 16px; border-radius: 14px; box-shadow: 0 5px 0 #d94a3d; }
  .fp-ship-change { background: none; border: none; padding: 0; font: inherit; font-size: 14px; font-weight: 800; color: #FF6B5E; cursor: pointer; text-decoration: underline; }
  .fp-ship-note { margin: 0; font-size: 13px; color: #6b5348; }
  .fp-ship-err { margin: 0; padding: 10px 14px; border-radius: 12px; background: #ffe9e6; color: #c2372b; font-weight: 800; font-size: 14px; }
  .fp-free-ship-tick { position: absolute; top: 0; bottom: 0; width: 3px; margin-left: -1px; background: #fff; }
  .fp-free-ship-marks { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 4px 14px; margin-top: 8px; font-size: 12px; font-weight: 800; color: #9a8377; }
  .fp-free-ship-marks .fp-mark-done { color: #23988d; }
  .fp-express { margin-top: 16px; }
  .fp-express-label { display: flex; align-items: center; gap: 10px; margin: 0 0 10px; font-size: 13px; font-weight: 700; color: #9a8377; }
  .fp-express-label::before, .fp-express-label::after { content: ""; flex: 1; height: 2px; background: #f6ece1; }
  .fp-express .additional-checkout-buttons, .fp-express shopify-accelerated-checkout-cart { --shopify-accelerated-checkout-button-border-radius: 16px; --shopify-accelerated-checkout-button-block-size: 48px; }
  [data-fp-cart-body] { transition: opacity .2s ease; }
  [data-fp-cart-body].fp-cart-busy { opacity: .55; pointer-events: none; }
  @media (max-width: 900px) {
    .fp-cart-grid { grid-template-columns: 1fr; }
    .fp-cart-summary { position: static; }
  }
  @media (max-width: 600px) {
    .fp-cart-page { padding: 120px 16px 60px; }
    .fp-cart-head h1 { font-size: 36px; }
    .fp-cart-item { grid-template-columns: 76px 1fr; gap: 14px; padding: 14px; }
    .fp-cart-thumb { width: 76px; height: 76px; font-size: 26px; border-radius: 16px; }
    .fp-cart-line { grid-column: 1 / -1; display: flex; justify-content: space-between; align-items: baseline; text-align: left; border-top: 2px dashed #f6ece1; padding-top: 10px; }
    .fp-cart-line strong { font-size: 21px; }
  }
</style>

<div class="fp-root" id="fp-cart-{{ section.id }}">

  <!-- NAV -->
  <nav class="fp-nav">
    {%- if section.settings.logo_image != blank -%}
      <a href="{{ routes.root_url }}" class="fp-logo"><img src="{{ section.settings.logo_image | image_url: width: 200 }}" alt="{{ shop.name }}"></a>
    {%- else -%}
      <a href="{{ routes.root_url }}" class="fp-logo">{{ section.settings.brand_name | default: shop.name }}</a>
    {%- endif -%}
    <div class="fp-nav-links">
      <a href="{{ routes.root_url }}#produse">Produse</a>
      <a href="{{ routes.root_url }}#faq">Întrebări</a>
      <a href="{{ routes.root_url }}#produse" class="fp-btn3d" style="background:#FF6B5E;color:#fff;font-family:'Baloo 2',cursive;font-weight:700;font-size:15px;padding:11px 20px;border-radius:16px;box-shadow:0 6px 0 #d94a3d;">Vezi colecția</a>
      <a href="{{ routes.cart_url }}" class="fp-cart" aria-label="Coș de cumpărături">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 7h12l-1 13H7L6 7z"/><path d="M9 7a3 3 0 0 1 6 0"/></svg>
        {%- if cart.item_count > 0 -%}<span class="fp-cart-count">{{ cart.item_count }}</span>{%- endif -%}
      </a>
    </div>
  </nav>

  <main class="fp-cart-page" data-fp-cart-body>
    {%- if cart.item_count == 0 -%}
      <div class="fp-cart-empty">
        <div class="fp-cart-empty-emoji" aria-hidden="true">🧸</div>
        <h2>{{ section.settings.empty_heading }}</h2>
        <p>{{ section.settings.empty_text }}</p>
        <a href="{{ routes.root_url }}#produse" class="fp-btn3d fp-cart-empty-btn">Descoperă colecția</a>
      </div>
    {%- else -%}
      <div class="fp-cart-head">
        <h1>{{ section.settings.heading }}</h1>
        <span>{{ cart.item_count }} {% if cart.item_count == 1 %}produs{% else %}produse{% endif %}</span>
      </div>

      {%- liquid
        # Two free-shipping tiers: locker / pickup point (lower) and home delivery (higher).
        assign free_locker = section.settings.free_shipping_threshold | times: 100
        assign free_home = section.settings.free_shipping_threshold_home | times: 100
        if free_home < free_locker
          assign free_home = free_locker
        endif
        assign free_locker_left = free_locker | minus: cart.total_price
        assign free_home_left = free_home | minus: cart.total_price
      -%}
      {%- if free_locker > 0 -%}
        {%- liquid
          assign free_progress = cart.total_price | times: 100 | divided_by: free_home
          if free_progress > 100
            assign free_progress = 100
          endif
          assign locker_mark = free_locker | times: 100 | divided_by: free_home
        -%}
        <div class="fp-free-ship{% if free_home_left <= 0 %} fp-free-ship-done{% endif %}">
          <p>
            {%- if free_locker_left > 0 -%}
              🚚 Mai adaugă <strong>{{ free_locker_left | money }}</strong> și ai livrare gratuită la locker sau punct de ridicare!
            {%- elsif free_home_left > 0 -%}
              🎉 Ai livrare gratuită la locker! Mai adaugă <strong>{{ free_home_left | money }}</strong> și o ai gratuită și acasă.
            {%- else -%}
              🎉 Felicitări, ai livrare gratuită, la locker sau acasă!
            {%- endif -%}
          </p>
          <div class="fp-free-ship-bar" role="progressbar" aria-label="Progres spre livrarea gratuită" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ free_progress }}"><span style="width:{{ free_progress }}%;"></span>{%- if free_home > free_locker -%}<i class="fp-free-ship-tick" style="left:{{ locker_mark }}%;"></i>{%- endif -%}</div>
          {%- if free_home > free_locker -%}
            <div class="fp-free-ship-marks">
              <span class="{% if free_locker_left <= 0 %}fp-mark-done{% endif %}">{% if free_locker_left <= 0 %}✓{% else %}📦{% endif %} Locker gratuit de la {{ free_locker | money }}</span>
              <span class="{% if free_home_left <= 0 %}fp-mark-done{% endif %}">{% if free_home_left <= 0 %}✓{% else %}🏠{% endif %} Acasă gratuit de la {{ free_home | money }}</span>
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="fp-cart-grid">
        <div class="fp-cart-items">
          {%- for item in cart.items -%}
            {%- assign gi = forloop.index0 | modulo: 6 -%}
            {%- assign emoji = item.product.metafields.custom.emoji.value | default: '🧸' -%}
            <div class="fp-cart-item">
              <a href="{{ item.url }}" class="fp-cart-thumb" style="background:{{ gradients[gi] }};">
                {%- if item.image -%}
                  <img src="{{ item.image | image_url: width: 220 }}" alt="{{ item.image.alt | default: item.product.title | escape }}" width="104" height="104" loading="lazy">
                {%- else -%}
                  <span aria-hidden="true">{{ emoji }}</span>
                {%- endif -%}
              </a>
              <div class="fp-cart-info">
                <h3><a href="{{ item.url }}">{{ item.product.title }}</a></h3>
                {%- unless item.product.has_only_default_variant -%}
                  <p class="fp-cart-variant">{{ item.variant.title }}</p>
                {%- endunless -%}
                {%- for property in item.properties -%}
                  {%- assign property_first_char = property.first | slice: 0 -%}
                  {%- if property.last != blank and property_first_char != '_' -%}
                    <p class="fp-cart-variant">{{ property.first }}: {{ property.last | split: ' (' | first }}</p>
                  {%- endif -%}
                {%- endfor -%}
                <p class="fp-cart-unit">{{ item.final_price | money }} / bucată</p>
                <div class="fp-cart-controls">
                  <div class="fp-qty">
                    <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity={{ item.quantity | minus: 1 }}" data-fp-qty data-line="{{ forloop.index }}" data-qty="{{ item.quantity | minus: 1 }}" aria-label="Scade cantitatea">−</a>
                    <span aria-label="Cantitate">{{ item.quantity }}</span>
                    <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity={{ item.quantity | plus: 1 }}" data-fp-qty data-line="{{ forloop.index }}" data-qty="{{ item.quantity | plus: 1 }}" aria-label="Crește cantitatea">+</a>
                  </div>
                  <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity=0" class="fp-cart-remove" data-fp-qty data-line="{{ forloop.index }}" data-qty="0">Șterge</a>
                </div>
              </div>
              <div class="fp-cart-line">
                {%- if item.original_line_price > item.final_line_price -%}<s>{{ item.original_line_price | money }}</s>{%- endif -%}
                <strong>{{ item.final_line_price | money }}</strong>
              </div>
            </div>
          {%- endfor -%}
        </div>

        <aside class="fp-cart-summary">
          <h2>Sumar comandă</h2>
          <div class="fp-cart-row"><span>Produse ({{ cart.item_count }})</span><span>{{ cart.items_subtotal_price | money }}</span></div>
          {%- for discount in cart.cart_level_discount_applications -%}
            <div class="fp-cart-row fp-cart-discount"><span>{{ discount.title }}</span><span>−{{ discount.total_allocated_amount | money }}</span></div>
          {%- endfor -%}
          <div class="fp-cart-row"><span>Livrare</span><span>{% if free_locker > 0 and free_home_left <= 0 %}gratuită 🎉{% elsif free_locker > 0 and free_locker_left <= 0 %}gratuită la locker 🎉{% else %}la pasul următor{% endif %}</span></div>
          <div class="fp-cart-total"><span>Total</span><strong>{{ cart.total_price | money }}</strong></div>
          <p class="fp-cart-note">{{ section.settings.shipping_note }}</p>
          {%- comment -%}
            Delivery choice (Packeta). Hidden until a Packeta API key is set in the section settings.
            The choice and the pickup point are saved as cart attributes, so they show on the order in Admin.
          {%- endcomment -%}
          {%- assign packeta_key = section.settings.packeta_api_key | strip -%}
          {%- if packeta_key != blank -%}
            {%- liquid
              assign ship_locker_label = 'Locker / punct de ridicare'
              assign ship_home_label = 'Curier la domiciliu'
              assign ship_method = cart.attributes['Livrare']
              assign ship_point = cart.attributes['Punct de ridicare']
              assign ship_state = ''
              if ship_method == ship_locker_label
                assign ship_state = 'locker'
              elsif ship_method == ship_home_label
                assign ship_state = 'home'
              endif
              assign locker_price = section.settings.locker_price | times: 100
              assign home_price = section.settings.home_price | times: 100
            -%}
            <div class="fp-ship" data-fp-ship data-key="{{ packeta_key | escape }}" data-state="{{ ship_state }}" data-has-point="{% if ship_point != blank %}1{% endif %}">
              <p class="fp-ship-h">Cum vrei să primești coletul?</p>
              <label class="fp-ship-opt{% if ship_state == 'locker' %} fp-ship-on{% endif %}">
                <input type="radio" name="fp_ship" value="locker" data-fp-ship-choice{% if ship_state == 'locker' %} checked{% endif %}>
                <span class="fp-ship-t">📦 Locker sau punct de ridicare<small>Packeta, easybox și alte rețele, aproape de tine</small></span>
                <span class="fp-ship-p">{% if free_locker > 0 and free_locker_left <= 0 %}gratuit{% elsif locker_price > 0 %}{{ locker_price | money }}{% endif %}</span>
              </label>
              {%- if ship_state == 'locker' -%}
                <div class="fp-ship-point">
                  {%- if ship_point != blank -%}
                    <p>📍 {{ ship_point }}</p>
                    <button type="button" class="fp-ship-change" data-fp-pick>Schimbă punctul</button>
                  {%- else -%}
                    <button type="button" class="fp-btn3d fp-ship-pick" data-fp-pick>Alege punctul pe hartă</button>
                  {%- endif -%}
                </div>
              {%- endif -%}
              <label class="fp-ship-opt{% if ship_state == 'home' %} fp-ship-on{% endif %}">
                <input type="radio" name="fp_ship" value="home" data-fp-ship-choice{% if ship_state == 'home' %} checked{% endif %}>
                <span class="fp-ship-t">🚚 Curier la domiciliu<small>Sameday, FAN Courier sau Cargus</small></span>
                <span class="fp-ship-p">{% if free_locker > 0 and free_home_left <= 0 %}gratuit{% elsif home_price > 0 %}{{ home_price | money }}{% endif %}</span>
              </label>
              {%- if ship_state != blank -%}
                <p class="fp-ship-note">La pasul următor alege aceeași variantă: „{% if ship_state == 'locker' %}Locker sau punct de ridicare (Packeta){% else %}Curier la domiciliu{% endif %}”.</p>
              {%- endif -%}
              <p class="fp-ship-err" data-fp-ship-err hidden></p>
            </div>
          {%- endif -%}
          <form action="{{ routes.cart_url }}" method="post" data-fp-checkout>
            <button type="submit" name="checkout" class="fp-btn3d fp-checkout-btn">Finalizează comanda</button>
          </form>
          {%- comment -%} Apple Pay / Google Pay / Shop Pay express buttons; Shopify renders them once the wallets are enabled. {%- endcomment -%}
          {%- if additional_checkout_buttons -%}
            <div class="fp-express">
              <p class="fp-express-label">sau plătește rapid cu</p>
              {{ content_for_additional_checkout_buttons }}
            </div>
          {%- endif -%}
          <a href="{{ routes.root_url }}#produse" class="fp-cart-continue">← Continuă cumpărăturile</a>
          <ul class="fp-cart-perks">
            <li>🚚 Livrare 3–6 zile, la locker sau acasă</li>
            <li>↩️ Retur în 14 zile</li>
            <li>🎁 Ambalat cadou, gata de dăruit</li>
          </ul>
        </aside>
      </div>
    {%- endif -%}
  </main>

  <!-- FOOTER -->
  {%- capture fp_shop_links -%}<a href="{{ routes.root_url }}#produse">Toate produsele</a>{%- endcapture -%}
  {%- render 'flexyplay-footer', brand_name: section.settings.brand_name, tagline: section.settings.footer_tagline, shop_links: fp_shop_links -%}
</div>

<script>
  (function () {
    var root = document.getElementById('fp-cart-{{ section.id }}');
    if (!root || !window.fetch || !window.DOMParser) return;
    var sectionId = '{{ section.id }}';

    function refresh(itemCount) {
      return fetch('{{ routes.cart_url }}?section_id=' + encodeURIComponent(sectionId))
        .then(function (res) { return res.text(); })
        .then(function (html) {
          var doc = new DOMParser().parseFromString(html, 'text/html');
          var fresh = doc.querySelector('[data-fp-cart-body]');
          var body = root.querySelector('[data-fp-cart-body]');
          if (!fresh || !body) throw new Error('missing cart body');
          body.innerHTML = fresh.innerHTML;
          body.classList.remove('fp-cart-busy');
          if (window.fpUpdateCartCount) window.fpUpdateCartCount(itemCount);
        });
    }

    var LOCKER = 'Locker / punct de ridicare', HOME = 'Curier la domiciliu';
    function saveAttributes(attrs) {
      root.querySelector('[data-fp-cart-body]').classList.add('fp-cart-busy');
      return fetch('{{ routes.cart_update_url }}.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ attributes: attrs })
      })
        .then(function (res) { if (!res.ok) throw new Error('update failed'); return res.json(); })
        .then(function (cart) { return refresh(cart.item_count); })
        .catch(function () { window.location.reload(); });
    }
    function loadPacketa() {
      if (window.Packeta && window.Packeta.Widget) return Promise.resolve();
      return new Promise(function (resolve, reject) {
        var s = document.createElement('script');
        s.src = 'https://widget.packeta.com/v6/www/js/library.js';
        s.onload = resolve; s.onerror = reject;
        document.head.appendChild(s);
      });
    }
    function pickPoint() {
      var box = root.querySelector('[data-fp-ship]');
      loadPacketa().then(function () {
        window.Packeta.Widget.pick(box.dataset.key, function (point) {
          if (!point) return;
          var label = point.formatedValue || [point.name, point.street, point.city].filter(Boolean).join(', ');
          saveAttributes({
            'Livrare': LOCKER,
            'Punct de ridicare': label,
            'Packeta ID punct': String(point.id || ''),
            'Packeta transportator': point.carrierId ? String(point.carrierId) + (point.carrierPickupPointId ? ' / ' + point.carrierPickupPointId : '') : ''
          });
        }, { country: 'ro', language: 'ro' });
      }).catch(function () { showShipError('Harta nu s-a putut încărca. Reîncarcă pagina și încearcă din nou.'); });
    }
    function showShipError(msg) {
      var err = root.querySelector('[data-fp-ship-err]');
      if (!err) return;
      err.textContent = msg; err.hidden = false;
      err.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }

    root.addEventListener('change', function (e) {
      var input = e.target.closest('[data-fp-ship-choice]');
      if (!input) return;
      if (input.value === 'home') {
        saveAttributes({ 'Livrare': HOME, 'Punct de ridicare': '', 'Packeta ID punct': '', 'Packeta transportator': '' });
      } else {
        var box = root.querySelector('[data-fp-ship]');
        saveAttributes({ 'Livrare': LOCKER }).then(function () { if (!box.dataset.hasPoint) pickPoint(); });
      }
    });

    root.addEventListener('submit', function (e) {
      if (!e.target.matches('[data-fp-checkout]')) return;
      var box = root.querySelector('[data-fp-ship]');
      if (!box) return;
      if (!box.dataset.state) { e.preventDefault(); showShipError('Alege mai întâi cum vrei să primești coletul: la locker sau acasă.'); }
      else if (box.dataset.state === 'locker' && !box.dataset.hasPoint) { e.preventDefault(); showShipError('Alege punctul de ridicare pe hartă, apoi finalizează comanda.'); }
    });

    root.addEventListener('click', function (e) {
      if (e.target.closest('[data-fp-pick]')) { e.preventDefault(); pickPoint(); return; }
      var link = e.target.closest('[data-fp-qty]');
      if (!link) return;
      e.preventDefault();
      root.querySelector('[data-fp-cart-body]').classList.add('fp-cart-busy');
      fetch('{{ routes.cart_change_url }}.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ line: Number(link.dataset.line), quantity: Number(link.dataset.qty) })
      })
        .then(function (res) { if (!res.ok) throw new Error('change failed'); return res.json(); })
        .then(function (cart) { return refresh(cart.item_count); })
        .catch(function () { window.location.href = link.href; });
    });
  })();
</script>

