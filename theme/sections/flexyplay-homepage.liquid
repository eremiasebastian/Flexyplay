{% comment %}
  FlexyPlay — Homepage section
  Recreated from the Claude Design prototype (Homepage.dc.html) for a real
  Shopify Online Store 2.0 theme. The product grid is driven by a real
  collection so it stays in sync as products are added/removed in Admin —
  nothing about the catalog is hardcoded here.
{% endcomment %}
{% render 'flexyplay-styles' %}

{%- liquid
  assign gradients = 'linear-gradient(150deg,#FFD166,#FF9E4F,#FF6B5E)|linear-gradient(150deg,#2EC4B6,#33b98f,#4bb96a)|linear-gradient(150deg,#FF6B5E,#ff5470,#ff8566)|linear-gradient(150deg,#FFD166,#e8b06a,#d69456)|linear-gradient(150deg,#8a5a3c,#a56b45,#c08856)|linear-gradient(150deg,#b98a5a,#caa06e,#e0bd8a)' | split: '|'
  assign emojis = '🐶🥐|🦡🗑️|🐞🌸|🦊🏜️|🦫|🐒' | split: '|'
  assign marquee_items = section.settings.marquee_items | newline_to_br | split: '<br />'
-%}

<div class="fp-root" id="fp-home-{{ section.id }}">

  <!-- NAV -->
  <nav class="fp-nav">
    {%- if section.settings.logo_image != blank -%}
      <a href="{{ routes.root_url }}" class="fp-logo"><img src="{{ section.settings.logo_image | image_url: width: 200 }}" alt="{{ shop.name }}"></a>
    {%- else -%}
      <a href="{{ routes.root_url }}" class="fp-logo">{{ section.settings.brand_name | default: shop.name }}</a>
    {%- endif -%}
    <div class="fp-nav-links">
      <a href="#produse">{{ section.settings.nav_link_1 }}</a>
      <a href="#proces">{{ section.settings.nav_link_2 }}</a>
      <a href="#faq">{{ section.settings.nav_link_3 }}</a>
      <a href="#produse" class="fp-btn3d" style="background:#FF6B5E;color:#fff;font-family:'Baloo 2',cursive;font-weight:700;font-size:15px;padding:11px 20px;border-radius:16px;box-shadow:0 6px 0 #d94a3d;">{{ section.settings.nav_cta_label }}</a>
    </div>
  </nav>

  <!-- HERO -->
  <header style="position:relative;padding:150px 24px 96px;text-align:center;overflow:hidden;">
    <div style="--r:-8deg;position:absolute;top:120px;left:6%;font-size:76px;animation:fp-float 6s ease-in-out infinite;opacity:.9;" aria-hidden="true">🐶</div>
    <div style="--r:10deg;position:absolute;top:180px;right:8%;font-size:64px;animation:fp-float 7s ease-in-out infinite .6s;opacity:.9;" aria-hidden="true">🦡</div>
    <div style="--r:-5deg;position:absolute;bottom:80px;left:12%;font-size:58px;animation:fp-float 5.5s ease-in-out infinite 1.1s;opacity:.9;" aria-hidden="true">🐞</div>
    <div style="--r:6deg;position:absolute;bottom:130px;right:14%;font-size:62px;animation:fp-float 6.5s ease-in-out infinite .3s;opacity:.9;" aria-hidden="true">🦊</div>
    <div style="--r:-10deg;position:absolute;top:250px;left:24%;font-size:44px;animation:fp-float 7.5s ease-in-out infinite .9s;opacity:.85;" aria-hidden="true">🦫</div>
    <div style="--r:8deg;position:absolute;top:230px;right:26%;font-size:46px;animation:fp-float 6.2s ease-in-out infinite 1.4s;opacity:.85;" aria-hidden="true">🐒</div>
    <div style="position:relative;max-width:820px;margin:0 auto;">
      {%- if section.settings.hero_badge != blank -%}
        <div class="fp-reveal fp-badge-pill" style="margin-bottom:24px;"><span class="fp-dot"></span>{{ section.settings.hero_badge }}</div>
      {%- endif -%}
      <h1 class="fp-reveal fp-hero-h1" style="font-family:'Baloo 2',cursive;font-weight:800;font-size:66px;line-height:1.02;letter-spacing:-1.5px;margin:0 0 22px;">{{ section.settings.hero_heading_part1 }} <span style="color:#FF6B5E;">{{ section.settings.hero_heading_highlight }}</span> {{ section.settings.hero_heading_part2 }}</h1>
      <p class="fp-reveal" style="font-size:20px;line-height:1.6;color:#6b5348;max-width:540px;margin:0 auto 34px;">{{ section.settings.hero_subtitle }}</p>
      <div class="fp-reveal" style="display:flex;gap:14px;justify-content:center;flex-wrap:wrap;">
        <a href="{{ section.settings.hero_cta_primary_link }}" class="fp-btn3d" style="background:#FF6B5E;color:#fff;font-family:'Baloo 2',cursive;font-weight:700;font-size:18px;padding:16px 32px;border-radius:18px;box-shadow:0 8px 0 #d94a3d;">{{ section.settings.hero_cta_primary_label }}</a>
        <a href="{{ section.settings.hero_cta_secondary_link }}" class="fp-btn3d" style="background:#fff;color:#432B21;font-family:'Baloo 2',cursive;font-weight:700;font-size:18px;padding:16px 32px;border-radius:18px;border:2px solid #efdcc7;box-shadow:0 8px 0 #efdcc7;">{{ section.settings.hero_cta_secondary_label }}</a>
      </div>
    </div>
  </header>

  <!-- MARQUEE -->
  {%- if marquee_items.size > 0 -%}
  <div style="background:#432B21;padding:16px 0;overflow:hidden;">
    <div class="fp-marquee-track">
      <div class="fp-marquee-set">
        {%- for item in marquee_items -%}<span>{{ item }}</span>{%- unless forloop.last -%}<span style="color:#FFD166;">•</span>{%- endunless -%}{%- endfor -%}
      </div>
      <div class="fp-marquee-set" aria-hidden="true">
        {%- for item in marquee_items -%}<span>{{ item }}</span>{%- unless forloop.last -%}<span style="color:#FFD166;">•</span>{%- endunless -%}{%- endfor -%}
      </div>
    </div>
  </div>
  {%- endif -%}

  <!-- PRODUSE -->
  <section id="produse" style="padding:84px 24px;max-width:1160px;margin:0 auto;">
    <div class="fp-reveal" style="text-align:center;margin-bottom:34px;">
      <h2 class="fp-section-h2" style="font-family:'Baloo 2',cursive;font-weight:800;font-size:44px;margin:0 0 10px;">{{ section.settings.products_heading }}</h2>
      <p style="font-size:18px;color:#6b5348;margin:0;">{{ section.settings.products_subheading }}</p>
    </div>

    <div data-fp-filters="fp-grid-{{ section.id }}" style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap;margin-bottom:40px;">
      <button type="button" class="fp-chip fp-chip-active" data-fp-filter="toate">Toate</button>
      <button type="button" class="fp-chip" data-fp-filter="playseturi">Playseturi complete</button>
      <button type="button" class="fp-chip" data-fp-filter="figurine">Figurine flexi</button>
      <button type="button" class="fp-chip" data-fp-filter="keychains">Keychains</button>
    </div>

    <div id="fp-grid-{{ section.id }}" class="fp-grid-3" style="display:grid;grid-template-columns:repeat(3,1fr);gap:24px;">
      {%- assign products = section.settings.collection.products -%}
      {%- for product in products limit: section.settings.max_products -%}
        {%- assign gi = forloop.index0 | modulo: 6 -%}
        {%- assign gradient = gradients[gi] -%}
        {%- assign emoji = emojis[gi] -%}
        {%- assign cat = '' -%}
        {%- if product.tags contains 'playseturi' -%}{%- assign cat = 'playseturi' -%}
        {%- elsif product.tags contains 'figurine' -%}{%- assign cat = 'figurine' -%}
        {%- elsif product.tags contains 'keychains' -%}{%- assign cat = 'keychains' -%}
        {%- endif -%}
        {%- assign badge_label = '' -%}
        {%- assign badge_bg = '#432B21' -%}
        {%- assign badge_color = '#FFD166' -%}
        {%- if product.tags contains 'bestseller' -%}
          {%- assign badge_label = 'Bestseller' -%} {%- assign badge_bg = '#432B21' -%} {%- assign badge_color = '#FFD166' -%}
        {%- elsif product.tags contains 'nou' -%}
          {%- assign badge_label = 'Nou' -%} {%- assign badge_bg = '#2EC4B6' -%} {%- assign badge_color = '#fff' -%}
        {%- elsif product.tags contains 'pret-prietenos' -%}
          {%- assign badge_label = 'Preț prietenos' -%} {%- assign badge_bg = '#FFD166' -%} {%- assign badge_color = '#432B21' -%}
        {%- elsif product.compare_at_price_min > product.price_min -%}
          {%- assign badge_label = 'Reducere' -%} {%- assign badge_bg = '#FF6B5E' -%} {%- assign badge_color = '#fff' -%}
        {%- endif -%}
        <a href="{{ product.url }}" class="fp-card fp-reveal" data-fp-card data-fp-cat="{{ cat }}" style="display:flex;flex-direction:column;background:#fff;border:2px solid #f0e2d2;border-radius:28px;overflow:hidden;box-shadow:0 12px 26px rgba(67,43,33,.07);color:#432B21;">
          <div style="position:relative;aspect-ratio:4/3;background:{{ gradient }};display:flex;align-items:center;justify-content:center;">
            {%- if product.featured_image -%}
              <img src="{{ product.featured_image | image_url: width: 700 }}" alt="{{ product.featured_image.alt | escape }}" loading="lazy" width="700" height="525" style="width:100%;height:100%;object-fit:cover;">
            {%- else -%}
              <span style="font-size:76px;">{{ emoji }}</span>
            {%- endif -%}
            {%- if badge_label != '' -%}
              <span style="position:absolute;top:14px;left:14px;background:{{ badge_bg }};color:{{ badge_color }};font-family:'Baloo 2',cursive;font-weight:800;font-size:12px;padding:6px 12px;border-radius:999px;">{{ badge_label }}</span>
            {%- endif -%}
          </div>
          <div style="padding:22px 22px 24px;display:flex;flex-direction:column;flex:1;">
            <h3 style="font-family:'Baloo 2',cursive;font-weight:700;font-size:21px;margin:0 0 6px;">{{ product.title }}</h3>
            <p style="font-size:15px;color:#6b5348;line-height:1.5;margin:0 0 18px;flex:1;">{{ product.description | strip_html | truncate: 100 }}</p>
            <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;">
              <span style="font-family:'Baloo 2',cursive;font-weight:800;font-size:26px;">{{ product.price_min | money }}</span>
              <span class="fp-btn3d" style="background:#FF6B5E;color:#fff;font-family:'Baloo 2',cursive;font-weight:700;font-size:15px;padding:11px 20px;border-radius:14px;box-shadow:0 5px 0 #d94a3d;">Vezi produsul</span>
            </div>
          </div>
        </a>
      {%- else -%}
        <div data-fp-empty style="grid-column:1/-1;text-align:center;padding:40px;background:#fff;border:2px dashed #f0e2d2;border-radius:24px;color:#6b5348;font-size:16px;">
          {{ section.settings.empty_state_text }}
        </div>
      {%- endfor -%}
    </div>
  </section>

  <!-- PROCES -->
  <section id="proces" style="background:#fff;border-top:2px solid #f0e2d2;border-bottom:2px solid #f0e2d2;padding:84px 24px;">
    <div style="max-width:1160px;margin:0 auto;">
      <div class="fp-reveal" style="text-align:center;margin-bottom:50px;">
        <h2 class="fp-section-h2" style="font-family:'Baloo 2',cursive;font-weight:800;font-size:42px;margin:0 0 10px;">{{ section.settings.process_heading }}</h2>
        <p style="font-size:18px;color:#6b5348;margin:0;">{{ section.settings.process_subheading }}</p>
      </div>
      <div class="fp-grid-4" style="display:grid;grid-template-columns:repeat(4,1fr);gap:22px;">
        {%- assign step_n = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'step' -%}
            {%- assign step_n = step_n | plus: 1 -%}
            <div class="fp-reveal" style="text-align:center;" {{ block.shopify_attributes }}>
              <div style="width:74px;height:74px;margin:0 auto 16px;border-radius:22px;background:{{ block.settings.color }};display:flex;align-items:center;justify-content:center;font-size:34px;box-shadow:0 10px 0 {{ block.settings.shadow_color }};">{{ block.settings.emoji }}</div>
              <div style="font-family:'Baloo 2',cursive;font-weight:800;color:#FF6B5E;font-size:15px;margin-bottom:4px;">{{ 'PASUL ' | append: step_n }}</div>
              <h3 style="font-family:'Baloo 2',cursive;font-weight:700;font-size:19px;margin:0 0 6px;">{{ block.settings.title }}</h3>
              <p style="font-size:15px;color:#6b5348;margin:0;line-height:1.5;">{{ block.settings.text }}</p>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>

  <!-- TRUST -->
  <section style="padding:60px 24px;max-width:1160px;margin:0 auto;">
    <div class="fp-grid-4" style="display:grid;grid-template-columns:repeat(4,1fr);gap:20px;">
      {%- for block in section.blocks -%}
        {%- if block.type == 'trust_item' -%}
          <div class="fp-reveal" style="display:flex;align-items:center;gap:14px;background:#fff;border:2px solid #f0e2d2;border-radius:20px;padding:18px 20px;" {{ block.shopify_attributes }}>
            <span style="font-size:30px;">{{ block.settings.emoji }}</span>
            <div><div style="font-family:'Baloo 2',cursive;font-weight:700;font-size:16px;">{{ block.settings.title }}</div><div style="font-size:13px;color:#6b5348;">{{ block.settings.subtitle }}</div></div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" style="padding:40px 24px 70px;max-width:760px;margin:0 auto;">
    <h2 class="fp-reveal fp-section-h2" style="font-family:'Baloo 2',cursive;font-weight:800;font-size:40px;text-align:center;margin:0 0 36px;">{{ section.settings.faq_heading }}</h2>
    <div data-fp-faq style="display:flex;flex-direction:column;gap:14px;">
      {%- for block in section.blocks -%}
        {%- if block.type == 'faq_item' -%}
          <div class="fp-reveal fp-faq-item" data-fp-faq-item {{ block.shopify_attributes }}>
            <button type="button" class="fp-faq-btn" data-fp-faq-toggle>
              {{ block.settings.question }}
              <span class="fp-faq-icon" data-fp-faq-icon>+</span>
            </button>
            <div class="fp-faq-panel" data-fp-faq-panel>
              <p>{{ block.settings.answer }}</p>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </section>

  <!-- WARNING -->
  <section style="padding:0 24px 70px;max-width:760px;margin:0 auto;">
    <div class="fp-reveal" style="display:flex;align-items:center;gap:18px;background:#FFD166;border:2px solid #e6b84a;border-radius:22px;padding:22px 26px;">
      <span style="font-size:38px;">⚠️</span>
      <div>
        <div style="font-family:'Baloo 2',cursive;font-weight:800;font-size:19px;color:#432B21;margin-bottom:2px;">{{ section.settings.warning_title }}</div>
        <p style="margin:0;font-size:15px;color:#5c4a20;line-height:1.5;">{{ section.settings.warning_text }}</p>
      </div>
    </div>
  </section>

  <!-- FOOTER -->
  <footer class="fp-footer" style="background:#2a1a13;color:#FFF6EC;padding:56px 24px 34px;">
    <div style="max-width:1160px;margin:0 auto;">
      <div style="display:flex;flex-wrap:wrap;gap:40px;justify-content:space-between;align-items:flex-start;padding-bottom:34px;border-bottom:1px solid #4a352b;">
        <div style="max-width:300px;">
          <span style="font-family:'Baloo 2',cursive;font-weight:800;font-size:28px;color:#fff;">{{ section.settings.brand_name | default: shop.name }}</span>
          <p style="font-size:15px;color:#c9b3a6;line-height:1.6;margin:12px 0 0;">{{ section.settings.footer_tagline }}</p>
        </div>
        <div style="display:flex;gap:56px;flex-wrap:wrap;">
          <div>
            <div style="font-family:'Baloo 2',cursive;font-weight:700;font-size:15px;color:#FFD166;margin-bottom:12px;">Magazin</div>
            <div style="display:flex;flex-direction:column;gap:9px;font-size:15px;"><a href="#produse">Playseturi complete</a><a href="#produse">Figurine flexi</a><a href="#produse">Keychains</a></div>
          </div>
          <div>
            <div style="font-family:'Baloo 2',cursive;font-weight:700;font-size:15px;color:#FFD166;margin-bottom:12px;">Ajutor</div>
            <div style="display:flex;flex-direction:column;gap:9px;font-size:15px;"><a href="#faq">Întrebări</a><a href="{{ section.settings.shipping_returns_url | default: '#' }}">Livrare &amp; retur</a><a href="{{ section.settings.contact_url | default: '#' }}">Contact</a></div>
          </div>
        </div>
      </div>
      <div style="padding-top:22px;font-size:13px;color:#9a8377;display:flex;flex-wrap:wrap;gap:12px;justify-content:space-between;">
        <span>© {{ 'now' | date: '%Y' }} {{ section.settings.brand_name | default: shop.name }}. Toate drepturile rezervate.</span>
        <span>{{ section.settings.footer_signature }}</span>
      </div>
    </div>
  </footer>

</div>

{% schema %}
{
  "name": "FlexyPlay Homepage",
  "settings": [
    { "type": "header", "content": "Brand" },
    { "type": "image_picker", "id": "logo_image", "label": "Logo (opțional, gol = wordmark text)" },
    { "type": "text", "id": "brand_name", "label": "Nume brand", "default": "FlexyPlay" },
    { "type": "header", "content": "Navigație" },
    { "type": "text", "id": "nav_link_1", "label": "Link 1", "default": "Playseturi" },
    { "type": "text", "id": "nav_link_2", "label": "Link 2", "default": "Cum e făcut" },
    { "type": "text", "id": "nav_link_3", "label": "Link 3", "default": "Întrebări" },
    { "type": "text", "id": "nav_cta_label", "label": "Text buton nav", "default": "Vezi colecția" },
    { "type": "header", "content": "Hero" },
    { "type": "text", "id": "hero_badge", "label": "Badge deasupra titlului", "default": "Printat 3D cu drag în România" },
    { "type": "text", "id": "hero_heading_part1", "label": "Titlu — partea 1", "default": "Jucării care se îndoaie," },
    { "type": "text", "id": "hero_heading_highlight", "label": "Titlu — cuvânt evidențiat", "default": "lumi" },
    { "type": "text", "id": "hero_heading_part2", "label": "Titlu — partea 2", "default": "care se deschid" },
    { "type": "textarea", "id": "hero_subtitle", "label": "Subtitlu", "default": "Animăluțe flexi complet articulate și playseturi în miniatură. Fiecare piesă e printată la comandă și ambalată cadou." },
    { "type": "text", "id": "hero_cta_primary_label", "label": "Buton principal — text", "default": "Descoperă colecția" },
    { "type": "text", "id": "hero_cta_primary_link", "label": "Buton principal — link", "default": "#produse", "info": "Poți lăsa #produse (sare la produse) sau pune un link întreg." },
    { "type": "text", "id": "hero_cta_secondary_label", "label": "Buton secundar — text", "default": "Cum sunt făcute" },
    { "type": "text", "id": "hero_cta_secondary_link", "label": "Buton secundar — link", "default": "#proces", "info": "Poți lăsa #proces sau pune un link întreg." },
    { "type": "header", "content": "Bandă marquee" },
    { "type": "textarea", "id": "marquee_items", "label": "Beneficii (unul pe linie)", "default": "🐾 Complet articulate\n🎁 Ambalate cadou\n♻️ Sigure 3+\n🇷🇴 Printate în România\n🚚 Livrare 2–4 zile" },
    { "type": "header", "content": "Produse" },
    { "type": "text", "id": "products_heading", "label": "Titlu secțiune", "default": "Colecția FlexyPlay" },
    { "type": "text", "id": "products_subheading", "label": "Subtitlu secțiune", "default": "Alege-ți preferatul — sau ia-le pe toate." },
    { "type": "collection", "id": "collection", "label": "Colecția afișată în grid" },
    { "type": "range", "id": "max_products", "label": "Nr. maxim de produse", "min": 3, "max": 12, "step": 1, "default": 6 },
    { "type": "textarea", "id": "empty_state_text", "label": "Text când colecția e goală", "default": "Momentan pregătim produsele — revino curând!" },
    { "type": "paragraph", "content": "Filtrele Playseturi / Figurine / Keychains se bazează pe tag-uri de produs cu aceleași nume (playseturi, figurine, keychains). Badge-urile Bestseller / Nou / Preț prietenos se bazează pe tag-urile bestseller, nou, pret-prietenos." },
    { "type": "header", "content": "Proces (\"De la idee la cutia ta\")" },
    { "type": "text", "id": "process_heading", "label": "Titlu", "default": "De la idee la cutia ta" },
    { "type": "text", "id": "process_subheading", "label": "Subtitlu", "default": "Fiecare jucărie e făcută pe bune, pentru tine." },
    { "type": "header", "content": "FAQ" },
    { "type": "text", "id": "faq_heading", "label": "Titlu", "default": "Întrebări frecvente" },
    { "type": "header", "content": "Avertisment" },
    { "type": "text", "id": "warning_title", "label": "Titlu", "default": "Atenție: piese mici" },
    { "type": "textarea", "id": "warning_text", "label": "Text", "default": "Nu este recomandat copiilor sub 3 ani. Conține piese mici — risc de sufocare. A se folosi sub supravegherea unui adult." },
    { "type": "header", "content": "Footer" },
    { "type": "textarea", "id": "footer_tagline", "label": "Descriere brand", "default": "Jucării flexi articulate, printate 3D cu drag în România." },
    { "type": "text", "id": "footer_signature", "label": "Linie finală, dreapta", "default": "Printat cu drag în România 🇷🇴" },
    { "type": "url", "id": "shipping_returns_url", "label": "Link livrare & retur" },
    { "type": "url", "id": "contact_url", "label": "Link contact" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Pas proces",
      "settings": [
        { "type": "text", "id": "emoji", "label": "Emoji", "default": "✏️" },
        { "type": "color", "id": "color", "label": "Culoare fundal", "default": "#2EC4B6" },
        { "type": "color", "id": "shadow_color", "label": "Culoare umbră", "default": "#23988d" },
        { "type": "text", "id": "title", "label": "Titlu", "default": "Design" },
        { "type": "text", "id": "text", "label": "Text", "default": "Descriere pas." }
      ]
    },
    {
      "type": "trust_item",
      "name": "Element bandă încredere",
      "settings": [
        { "type": "text", "id": "emoji", "label": "Emoji", "default": "🧸" },
        { "type": "text", "id": "title", "label": "Titlu", "default": "Sigur 3+" },
        { "type": "text", "id": "subtitle", "label": "Subtitlu", "default": "Materiale testate" }
      ]
    },
    {
      "type": "faq_item",
      "name": "Întrebare FAQ",
