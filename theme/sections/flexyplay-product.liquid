{% comment %}
  FlexyPlay — Product page section
  Recreated from the Claude Design prototype (Pug Bakery Playset.dc.html).
  Assign via an alternate template (templates/product.flexyplay.json) to
  whichever product(s) should use the FlexyPlay design — other products
  keep the theme's default product page.

  Real functionality, not a mockup:
  - Variant cards are generated from the product's actual variants.
  - "Adaugă în coș" / "Comandă acum" submit a real POST to /cart/add.
  - Sold-out variants are disabled automatically.
{% endcomment %}
{% render 'flexyplay-styles' %}

{%- liquid
  assign marquee_items = section.settings.marquee_items | newline_to_br | split: '<br />'
  assign variants = product.variants
  assign featured_variant_title = section.settings.featured_variant_title | downcase
  assign v1_bullets = section.settings.variant_1_bullets | newline_to_br | split: '<br />'
  assign v2_bullets = section.settings.variant_2_bullets | newline_to_br | split: '<br />'
  assign v3_bullets = section.settings.variant_3_bullets | newline_to_br | split: '<br />'
-%}

<div class="fp-root" id="fp-product-{{ section.id }}">

  <!-- NAV -->
  <nav class="fp-nav">
    {%- if section.settings.logo_image != blank -%}
      <a href="{{ routes.root_url }}" class="fp-logo"><img src="{{ section.settings.logo_image | image_url: width: 200 }}" alt="{{ shop.name }}"></a>
    {%- else -%}
      <a href="{{ routes.root_url }}" class="fp-logo">{{ section.settings.brand_name | default: shop.name }}</a>
    {%- endif -%}
    <div class="fp-nav-links">
      <a href="#variante">Variante</a>
      <a href="#proces">Cum se face</a>
      <a href="#faq">Întrebări</a>
      <a href="#variante" class="fp-btn3d" style="background:#FF6B5E;color:#fff;font-family:'Baloo 2',cursive;font-weight:700;font-size:15px;padding:11px 20px;border-radius:16px;box-shadow:0 6px 0 #d94a3d;">Comandă acum</a>
    </div>
  </nav>

  <!-- HERO -->
  <header style="padding:132px 24px 40px;max-width:1160px;margin:0 auto;">
    <div class="fp-hero-grid" style="display:grid;grid-template-columns:1.05fr 1fr;gap:52px;align-items:center;">
      <div class="fp-reveal">
        {%- if section.settings.hero_badge != blank -%}
          <div class="fp-badge-pill" style="margin-bottom:22px;"><span class="fp-dot"></span>{{ section.settings.hero_badge }}</div>
        {%- endif -%}
        <h1 class="fp-hero-h1" style="font-family:'Baloo 2',cursive;font-weight:800;font-size:60px;line-height:1.02;letter-spacing:-1px;margin:0 0 20px;">
          {%- if section.settings.headline_prefix != blank -%}
            {{ section.settings.headline_prefix }} <span style="color:#FF6B5E;">{{ section.settings.headline_highlight }}</span> {{ section.settings.headline_suffix }}
          {%- else -%}
            {{ product.title }}
          {%- endif -%}
        </h1>
        <p style="font-size:19px;line-height:1.6;color:#6b5348;max-width:460px;margin:0 0 30px;">{{ section.settings.subtitle | default: product.description | strip_html | truncate: 220 }}</p>
        <div style="display:flex;align-items:baseline;gap:14px;margin-bottom:30px;">
          <span style="font-family:'Baloo 2',cursive;font-weight:800;font-size:42px;color:#432B21;">{{ product.price_min | money }}</span>
          {%- if product.compare_at_price_min > product.price_min -%}
            <span style="font-size:18px;color:#b09a8c;text-decoration:line-through;">{{ product.compare_at_price_min | money }}</span>
            {%- assign discount = product.compare_at_price_min | minus: product.price_min | times: 100 | divided_by: product.compare_at_price_min -%}
            <span style="background:#FFD166;color:#432B21;font-weight:800;font-size:13px;padding:5px 11px;border-radius:999px;">-{{ discount }}%</span>
          {%- endif -%}
        </div>
        <div style="display:flex;gap:14px;flex-wrap:wrap;">
          <a href="#variante" class="fp-btn3d" style="background:#FF6B5E;color:#fff;font-family:'Baloo 2',cursive;font-weight:700;font-size:18px;padding:16px 30px;border-radius:18px;box-shadow:0 8px 0 #d94a3d;">{{ section.settings.cta_primary_label }}</a>
          <a href="#demo" class="fp-btn3d" style="background:#fff;color:#432B21;font-family:'Baloo 2',cursive;font-weight:700;font-size:18px;padding:16px 30px;border-radius:18px;border:2px solid #efdcc7;box-shadow:0 8px 0 #efdcc7;">{{ section.settings.cta_secondary_label }}</a>
        </div>
      </div>

      <div class="fp-reveal" style="position:relative;">
        <div style="position:relative;background:linear-gradient(150deg,{{ section.settings.frame_color_1 }},{{ section.settings.frame_color_2 }});border-radius:40px;padding:20px;box-shadow:0 30px 60px rgba(46,196,182,.35);">
          <div style="aspect-ratio:4/5;border-radius:28px;overflow:hidden;background:repeating-linear-gradient(135deg,#ffffff,#ffffff 14px,#f2fbf9 14px,#f2fbf9 28px);display:flex;align-items:center;justify-content:center;">
            {%- if product.featured_image -%}
              <img src="{{ product.featured_image | image_url: width: 900 }}" alt="{{ product.featured_image.alt | escape }}" width="900" height="1125" style="width:100%;height:100%;object-fit:cover;">
            {%- else -%}
              <span style="font-family:monospace;font-size:13px;color:#7a9a95;text-align:center;padding:0 20px;">[ poză produs ]<br>{{ product.title }}<br>urcă o poză în Admin</span>
            {%- endif -%}
          </div>
        </div>
        {%- if product.images.size > 1 -%}
          <div style="display:flex;gap:10px;justify-content:center;margin-top:14px;flex-wrap:wrap;">
            {%- for image in product.images limit: 6 -%}
              <a href="{{ image | image_url: width: 900 }}" data-fp-thumb style="display:block;width:56px;height:56px;border-radius:12px;overflow:hidden;border:2px solid #f0e2d2;">
                <img src="{{ image | image_url: width: 120 }}" alt="" width="56" height="56" style="width:100%;height:100%;object-fit:cover;">
              </a>
            {%- endfor -%}
          </div>
        {%- endif -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'floating_badge' -%}
            {%- case block.settings.position -%}
              {%- when 'top_left' -%}{%- assign pos = '--r:-6deg;top:-14px;left:-26px;' -%}
              {%- when 'bottom_right' -%}{%- assign pos = '--r:5deg;bottom:24px;right:-30px;' -%}
              {%- else -%}{%- assign pos = '--r:-3deg;bottom:-18px;left:30px;' -%}
            {%- endcase -%}
            <div style="{{ pos }}position:absolute;animation:fp-float-sm 5.5s ease-in-out infinite;background:{{ block.settings.bg_color }};border-radius:16px;padding:10px 15px;box-shadow:0 12px 24px rgba(67,43,33,.14);font-weight:800;font-size:14px;color:{{ block.settings.text_color }};" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </header>

  <!-- MARQUEE -->
  {%- if marquee_items.size > 0 -%}
  <div style="margin-top:26px;background:#432B21;padding:16px 0;overflow:hidden;">
    <div class="fp-marquee-track">
      <div class="fp-marquee-set">
        {%- for item in marquee_items -%}<span>{{ item }}</span>{%- unless forloop.last -%}<span style="color:#FFD166;">•</span>{%- endunless -%}{%- endfor -%}
      </div>
      <div class="fp-marquee-set" aria-hidden="true">
        {%- for item in marquee_items -%}<span>{{ item }}</span>{%- unless forloop.last -%}<span style="color:#FFD166;">•</span>{%- endunless -%}{%- endfor -%}
      </div>
    </div>
  </div>
  {%- endif -%}

  <!-- DEMO -->
  <section id="demo" style="padding:90px 24px;max-width:1160px;margin:0 auto;">
    <div class="fp-demo-grid" style="display:grid;grid-template-columns:.85fr 1.15fr;gap:56px;align-items:center;">
      <div class="fp-reveal" style="position:relative;">
        <div style="aspect-ratio:9/16;max-width:320px;margin:0 auto;border-radius:32px;background:linear-gradient(160deg,#FFD166,#FF9E4F);padding:14px;box-shadow:0 26px 50px rgba(255,158,79,.35);">
          <div style="width:100%;height:100%;border-radius:22px;overflow:hidden;background:repeating-linear-gradient(45deg,#fff,#fff 12px,#fff5e6 12px,#fff5e6 24px);display:flex;align-items:center;justify-content:center;">
            {%- if section.settings.demo_video != blank -%}
              {{ section.settings.demo_video | video_tag: autoplay: true, loop: true, muted: true, controls: false, class: 'fp-demo-video' }}
            {%- else -%}
              <span style="font-family:monospace;font-size:12px;color:#b58a4a;text-align:center;padding:0 16px;">[ video vertical ]<br>demo articulație<br>9:16 · loop</span>
            {%- endif -%}
          </div>
        </div>
      </div>
      <div>
        <h2 class="fp-reveal fp-section-h2" style="font-family:'Baloo 2',cursive;font-weight:800;font-size:40px;line-height:1.08;margin:0 0 14px;">{{ section.settings.demo_heading }}</h2>
        <p class="fp-reveal" style="font-size:18px;color:#6b5348;line-height:1.6;margin:0 0 32px;max-width:440px;">{{ section.settings.demo_subheading }}</p>
        <div class="fp-grid-4" style="display:grid;grid-template-columns:1fr 1fr;gap:18px;">
          {%- for block in section.blocks -%}
            {%- if block.type == 'feature' -%}
              <div class="fp-reveal fp-card" style="background:#fff;border:2px solid #f0e2d2;border-radius:22px;padding:22px;" {{ block.shopify_attributes }}>
                <div style="width:46px;height:46px;border-radius:14px;background:{{ block.settings.color }};display:flex;align-items:center;justify-content:center;font-size:24px;margin-bottom:14px;">{{ block.settings.emoji }}</div>
                <h3 style="font-family:'Baloo 2',cursive;font-weight:700;font-size:19px;margin:0 0 6px;">{{ block.settings.title }}</h3>
                <p style="font-size:15px;color:#6b5348;margin:0;line-height:1.5;">{{ block.settings.text }}</p>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </section>

  <!-- VARIANTE -->
  <section id="variante" style="padding:30px 24px 90px;max-width:1160px;margin:0 auto;">
    <div class="fp-reveal" style="text-align:center;margin-bottom:44px;">
      <h2 class="fp-section-h2" style="font-family:'Baloo 2',cursive;font-weight:800;font-size:42px;margin:0 0 10px;">{{ section.settings.variants_heading }}</h2>
      <p style="font-size:18px;color:#6b5348;margin:0;">{{ section.settings.variants_subheading }}</p>
    </div>
    <div class="fp-variants-grid" style="display:grid;grid-template-columns:repeat(auto-fit, minmax(260px, 1fr));gap:22px;align-items:center;">
      {%- for variant in variants -%}
        {%- assign is_featured = false -%}
        {%- assign variant_title_lc = variant.title | downcase -%}
        {%- if variant_title_lc == featured_variant_title -%}{%- assign is_featured = true -%}{%- endif -%}
        {%- case forloop.index -%}
          {%- when 1 -%}{%- assign bullets = v1_bullets -%}{%- assign v_subtitle = section.settings.variant_1_subtitle -%}
          {%- when 2 -%}{%- assign bullets = v2_bullets -%}{%- assign v_subtitle = section.settings.variant_2_subtitle -%}
          {%- when 3 -%}{%- assign bullets = v3_bullets -%}{%- assign v_subtitle = section.settings.variant_3_subtitle -%}
          {%- else -%}{%- assign bullets = blank -%}{%- assign v_subtitle = blank -%}
        {%- endcase -%}
        <form method="post" action="{{ routes.cart_add_url }}" class="fp-reveal fp-card" style="{% if is_featured %}background:linear-gradient(165deg,#FF6B5E,#ff8566);border-radius:32px;padding:34px 30px;box-shadow:0 24px 46px rgba(255,107,94,.4);color:#fff;{% else %}background:#fff;border:2px solid #f0e2d2;border-radius:28px;padding:30px;box-shadow:0 14px 30px rgba(67,43,33,.07);{% endif %}position:relative;">
          <input type="hidden" name="id" value="{{ variant.id }}">
          {%- if is_featured -%}
            <span style="position:absolute;top:-14px;left:50%;transform:translateX(-50%);background:#FFD166;color:#432B21;font-family:'Baloo 2',cursive;font-weight:800;font-size:13px;padding:6px 16px;border-radius:999px;white-space:nowrap;">{{ section.settings.featured_label }}</span>
          {%- endif -%}
          <h3 style="font-family:'Baloo 2',cursive;font-weight:700;font-size:{% if is_featured %}24{% else %}22{% endif %}px;margin:0 0 4px;">{{ variant.title }}</h3>
          {%- if v_subtitle != blank -%}
          <p style="font-size:15px;color:{% if is_featured %}#ffe4df{% else %}#6b5348{% endif %};margin:0 0 18px;">{{ v_subtitle }}</p>
          {%- endif -%}
          <div style="display:flex;align-items:baseline;gap:10px;margin-bottom:18px;">
            <span style="font-family:'Baloo 2',cursive;font-weight:800;font-size:{% if is_featured %}40{% else %}36{% endif %}px;">{{ variant.price | money }}</span>
            {%- if variant.compare_at_price > variant.price -%}
              <span style="font-size:16px;color:{% if is_featured %}#ffd9d3{% else %}#b09a8c{% endif %};text-decoration:line-through;">{{ variant.compare_at_price | money }}</span>
            {%- endif -%}
          </div>
          {%- if bullets.size > 0 -%}
            <ul style="list-style:none;padding:0;margin:0 0 24px;font-size:15px;color:{% if is_featured %}#fff{% else %}#6b5348{% endif %};line-height:2;">
              {%- for bullet in bullets -%}<li>{{ bullet }}</li>{%- endfor -%}
            </ul>
          {%- endif -%}
          {%- if variant.available -%}
            <button type="submit" class="fp-btn3d" style="width:100%;display:block;text-align:center;{% if is_featured %}background:#fff;color:#FF6B5E;font-weight:800;font-size:17px;padding:16px;box-shadow:0 6px 0 #d94a3d;{% else %}background:#fff;color:#432B21;font-weight:700;font-size:16px;padding:14px;border:2px solid #efdcc7;box-shadow:0 6px 0 #efdcc7;{% endif %}font-family:'Baloo 2',cursive;border-radius:16px;">{% if is_featured %}{{ section.settings.featured_cta_label }}{% else %}{{ section.settings.default_cta_label }}{% endif %}</button>
          {%- else -%}
            <button type="button" class="fp-btn3d" disabled style="width:100%;display:block;text-align:center;background:#efdcc7;color:#8a7362;font-family:'Baloo 2',cursive;font-weight:700;font-size:16px;padding:14px;border:none;border-radius:16px;">Stoc epuizat</button>
          {%- endif -%}
        </form>
      {%- endfor -%}
    </div>
  </section>

  <!-- PROCES -->
  <section id="proces" style="background:#fff;border-top:2px solid #f0e2d2;border-bottom:2px solid #f0e2d2;padding:84px 24px;">
    <div style="max-width:1160px;margin:0 auto;">
      <div class="fp-reveal" style="text-align:center;margin-bottom:50px;">
        <h2 class="fp-section-h2" style="font-family:'Baloo 2',cursive;font-weight:800;font-size:42px;margin:0 0 10px;">{{ section.settings.process_heading }}</h2>
        <p style="font-size:18px;color:#6b5348;margin:0;">{{ section.settings.process_subheading }}</p>
      </div>
      <div class="fp-grid-4" style="display:grid;grid-template-columns:repeat(4,1fr);gap:22px;">
        {%- assign step_n = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'step' -%}
            {%- assign step_n = step_n | plus: 1 -%}
            <div class="fp-reveal" style="text-align:center;" {{ block.shopify_attributes }}>
              <div style="width:74px;height:74px;margin:0 auto 16px;border-radius:22px;background:{{ block.settings.color }};display:flex;align-items:center;justify-content:center;font-size:34px;box-shadow:0 10px 0 {{ block.settings.shadow_color }};">{{ block.settings.emoji }}</div>
              <div style="font-family:'Baloo 2',cursive;font-weight:800;color:#FF6B5E;font-size:15px;margin-bottom:4px;">{{ 'PASUL ' | append: step_n }}</div>
              <h3 style="font-family:'Baloo 2',cursive;font-weight:700;font-size:19px;margin:0 0 6px;">{{ block.settings.title }}</h3>
              <p style="font-size:15px;color:#6b5348;margin:0;line-height:1.5;">{{ block.settings.text }}</p>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>

  <!-- TRUST -->
  <section style="padding:60px 24px;max-width:1160px;margin:0 auto;">
    <div class="fp-grid-4" style="display:grid;grid-template-columns:repeat(4,1fr);gap:20px;">
      {%- for block in section.blocks -%}
        {%- if block.type == 'trust_item' -%}
          <div class="fp-reveal" style="display:flex;align-items:center;gap:14px;background:#fff;border:2px solid #f0e2d2;border-radius:20px;padding:18px 20px;" {{ block.shopify_attributes }}>
            <span style="font-size:30px;">{{ block.settings.emoji }}</span>
            <div><div style="font-family:'Baloo 2',cursive;font-weight:700;font-size:16px;">{{ block.settings.title }}</div><div style="font-size:13px;color:#6b5348;">{{ block.settings.subtitle }}</div></div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" style="padding:40px 24px 70px;max-width:760px;margin:0 auto;">
    <h2 class="fp-reveal fp-section-h2" style="font-family:'Baloo 2',cursive;font-weight:800;font-size:40px;text-align:center;margin:0 0 36px;">{{ section.settings.faq_heading }}</h2>
    <div data-fp-faq style="display:flex;flex-direction:column;gap:14px;">
      {%- for block in section.blocks -%}
        {%- if block.type == 'faq_item' -%}
          <div class="fp-reveal fp-faq-item" data-fp-faq-item {{ block.shopify_attributes }}>
            <button type="button" class="fp-faq-btn" data-fp-faq-toggle>
              {{ block.settings.question }}
              <span class="fp-faq-icon" data-fp-faq-icon>+</span>
            </button>
            <div class="fp-faq-panel" data-fp-faq-panel>
              <p>{{ block.settings.answer }}</p>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </section>

  <!-- WARNING -->
  <section style="padding:0 24px 70px;max-width:760px;margin:0 auto;">
    <div class="fp-reveal" style="display:flex;align-items:center;gap:18px;background:#FFD166;border:2px solid #e6b84a;border-radius:22px;padding:22px 26px;">
      <span style="font-size:38px;">⚠️</span>
      <div>
        <div style="font-family:'Baloo 2',cursive;font-weight:800;font-size:19px;color:#432B21;margin-bottom:2px;">{{ section.settings.warning_title }}</div>
        <p style="margin:0;font-size:15px;color:#5c4a20;line-height:1.5;">{{ section.settings.warning_text }}</p>
      </div>
    </div>
  </section>

  <!-- FOOTER -->
  <footer class="fp-footer" style="background:#2a1a13;color:#FFF6EC;padding:56px 24px 34px;">
    <div style="max-width:1160px;margin:0 auto;">
      <div style="display:flex;flex-wrap:wrap;gap:40px;justify-content:space-between;align-items:flex-start;padding-bottom:34px;border-bottom:1px solid #4a352b;">
        <div style="max-width:300px;">
          <span style="font-family:'Baloo 2',cursive;font-weight:800;font-size:28px;color:#fff;">{{ section.settings.brand_name | default: shop.name }}</span>
          <p style="font-size:15px;color:#c9b3a6;line-height:1.6;margin:12px 0 0;">{{ section.settings.footer_tagline }}</p>
        </div>
        <div style="display:flex;gap:56px;flex-wrap:wrap;">
          <div>
            <div style="font-family:'Baloo 2',cursive;font-weight:700;font-size:15px;color:#FFD166;margin-bottom:12px;">Magazin</div>
            <div style="display:flex;flex-direction:column;gap:9px;font-size:15px;"><a href="#variante">{{ product.title }}</a><a href="#variante">Toate variantele</a><a href="{{ routes.root_url }}">Înapoi la magazin</a></div>
          </div>
          <div>
            <div style="font-family:'Baloo 2',cursive;font-weight:700;font-size:15px;color:#FFD166;margin-bottom:12px;">Ajutor</div>
            <div style="display:flex;flex-direction:column;gap:9px;font-size:15px;"><a href="#faq">Întrebări</a><a href="{{ section.settings.shipping_returns_url | default: '#' }}">Livrare &amp; retur</a><a href="{{ section.settings.contact_url | default: '#' }}">Contact</a></div>
          </div>
        </div>
      </div>
      <div style="padding-top:22px;font-size:13px;color:#9a8377;display:flex;flex-wrap:wrap;gap:12px;justify-content:space-between;">
        <span>© {{ 'now' | date: '%Y' }} {{ section.settings.brand_name | default: shop.name }}. Toate drepturile rezervate.</span>
        <span>{{ section.settings.footer_signature }}</span>
      </div>
    </div>
  </footer>

</div>

{% if product.images.size > 1 %}
<script>
  (function(){
    var root = document.getElementById('fp-product-{{ section.id }}');
    if (!root) return;
    var main = root.querySelector('header img');
    root.querySelectorAll('[data-fp-thumb]').forEach(function(thumb){
      thumb.addEventListener('click', function(e){
        e.preventDefault();
        if (main) main.src = thumb.getAttribute('href');
      });
    });
  })();
</script>
{% endif %}

{% schema %}
{
  "name": "FlexyPlay Produs",
  "settings": [
    { "type": "header", "content": "Brand" },
    { "type": "image_picker", "id": "logo_image", "label": "Logo (opțional, gol = wordmark text)" },
    { "type": "text", "id": "brand_name", "label": "Nume brand", "default": "FlexyPlay" },
    { "type": "header", "content": "Hero" },
    { "type": "text", "id": "hero_badge", "label": "Badge deasupra titlului", "default": "Ediție limitată · Printat în România" },
    { "type": "paragraph", "content": "Titlul din 3 bucăți, cu partea din mijloc evidențiată coral. Lasă 'Titlu — partea 1' gol ca să folosești automat titlul produsului din Admin." },
    { "type": "text", "id": "headline_prefix", "label": "Titlu — partea 1", "default": "Mopsul care se îndoaie," },
    { "type": "text", "id": "headline_highlight", "label": "Titlu — cuvânt evidențiat", "default": "brutăria" },
    { "type": "text", "id": "headline_suffix", "label": "Titlu — partea 2", "default": "care se deschide" },
    { "type": "textarea", "id": "subtitle", "label": "Subtitlu (gol = descrierea produsului)", "default": "Un mops flexi complet articulat plus brutăria lui în miniatură — croissante, cupcakes și tejghea. Vine în cutie cadou, gata de dăruit." },
    { "type": "text", "id": "cta_primary_label", "label": "Buton principal — text", "default": "Comandă setul complet" },
    { "type": "text", "id": "cta_secondary_label", "label": "Buton secundar — text", "default": "Vezi cum se mișcă" },
