{%- comment -%}
  FlexyPlay shared styles + behavior, used by both
  sections/flexyplay-homepage.liquid and sections/flexyplay-product.liquid.
  Loaded via the flexyplay-styles snippet at the top of each section.
  Safe to render more than once on a page (rules are idempotent).
{%- endcomment -%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;600;700;800&family=Nunito:ital,wght@0,400;0,600;0,700;0,800;1,600&display=swap" rel="stylesheet">

<style>
  .fp-root, .fp-root * { box-sizing: border-box; }
  .fp-root { background: #FFF6EC; color: #432B21; font-family: 'Nunito', sans-serif; -webkit-font-smoothing: antialiased; overflow-x: hidden; }
  .fp-root a { color: #FF6B5E; text-decoration: none; }
  .fp-root a:hover { color: #e85546; }
  html { scroll-behavior: smooth; }

  @keyframes fp-float { 0%,100% { transform: translateY(0) rotate(var(--r,0deg)); } 50% { transform: translateY(-22px) rotate(var(--r,0deg)); } }
  @keyframes fp-float-sm { 0%,100% { transform: translateY(0) rotate(var(--r,0deg)); } 50% { transform: translateY(-14px) rotate(var(--r,0deg)); } }
  @keyframes fp-marquee { from { transform: translateX(0); } to { transform: translateX(-50%); } }

  .fp-reveal { opacity: 0; transform: translateY(34px); transition: opacity .7s cubic-bezier(.22,1,.36,1), transform .7s cubic-bezier(.22,1,.36,1); }
  .fp-reveal.fp-in { opacity: 1; transform: none; }

  .fp-btn3d { transition: transform .12s ease, box-shadow .12s ease; cursor: pointer; border: none; font-family: inherit; }
  .fp-btn3d:hover { transform: translateY(-2px); }
  .fp-btn3d:active { transform: translateY(4px); }
  .fp-btn3d:disabled { opacity: .55; cursor: not-allowed; transform: none !important; }

  .fp-card { transition: transform .25s cubic-bezier(.22,1,.36,1), box-shadow .25s ease; }
  .fp-card:hover { transform: translateY(-8px); box-shadow: 0 22px 42px rgba(67,43,33,.14); }

  .fp-chip { cursor: pointer; font-family: 'Baloo 2', cursive; font-weight: 700; font-size: 15px; padding: 10px 20px; border-radius: 999px; border: 2px solid #efdcc7; background: #fff; color: #432B21; box-shadow: 0 5px 0 #efdcc7; transition: transform .12s ease, background .2s ease, color .2s ease, border-color .2s ease, box-shadow .2s ease; }
  .fp-chip:hover { transform: translateY(-2px); }
  .fp-chip.fp-chip-active { background: #FF6B5E; color: #fff; border-color: #FF6B5E; box-shadow: 0 5px 0 #d94a3d; }

  .fp-nav { position: fixed; top: 18px; left: 50%; transform: translateX(-50%); z-index: 50; width: calc(100% - 32px); max-width: 1120px; display: flex; align-items: center; justify-content: space-between; background: rgba(255,246,236,.86); backdrop-filter: blur(14px); border: 2px solid #f0e2d2; border-radius: 22px; padding: 12px 14px 12px 22px; box-shadow: 0 10px 30px rgba(67,43,33,.10); }
  .fp-logo { display: inline-flex; align-items: center; font-family: 'Baloo 2', cursive; font-weight: 800; font-size: 26px; letter-spacing: -.5px; background: linear-gradient(90deg,#2EC4B6,#4bb96a,#FFD166,#FF9E4F,#FF6B5E); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .fp-logo img { display: block; height: 46px; width: auto; }
  .fp-nav-links { display: flex; align-items: center; gap: 22px; }
  .fp-nav-links a:not(.fp-btn3d) { color: #432B21; font-weight: 700; font-size: 15px; }

  .fp-badge-pill { display: inline-flex; align-items: center; gap: 8px; background: #fff; border: 2px solid #ffe0aa; color: #432B21; font-weight: 800; font-size: 13px; padding: 7px 14px; border-radius: 999px; }
  .fp-dot { width: 9px; height: 9px; border-radius: 50%; background: #2EC4B6; display: inline-block; }

  .fp-marquee-track { display: flex; width: max-content; animation: fp-marquee 26s linear infinite; }
  .fp-marquee-set { display: flex; gap: 44px; padding-right: 44px; font-family: 'Baloo 2', cursive; font-weight: 700; font-size: 19px; color: #FFF6EC; white-space: nowrap; }

  .fp-faq-item { background: #fff; border: 2px solid #f0e2d2; border-radius: 20px; overflow: hidden; }
  .fp-faq-btn { width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 16px; background: none; border: none; cursor: pointer; padding: 20px 22px; text-align: left; font-family: 'Baloo 2', cursive; font-weight: 700; font-size: 18px; color: #432B21; }
  .fp-faq-icon { flex: none; width: 30px; height: 30px; border-radius: 50%; background: #FFF6EC; display: flex; align-items: center; justify-content: center; font-size: 20px; color: #FF6B5E; transition: transform .25s ease; }
  .fp-faq-panel { max-height: 0; overflow: hidden; transition: max-height .3s ease; }
  .fp-faq-panel p { padding: 0 22px 20px; margin: 0; font-size: 16px; color: #6b5348; line-height: 1.6; }

  .fp-footer a { color: #e9d9cf; }
  .fp-footer a:hover { color: #fff; }

  .fp-demo-video { width: 100%; height: 100%; object-fit: cover; display: block; }

  /* Responsive */
  @media (max-width: 900px) {
    .fp-hero-grid, .fp-demo-grid { grid-template-columns: 1fr !important; }
    .fp-grid-3 { grid-template-columns: repeat(2,1fr) !important; }
    .fp-grid-4 { grid-template-columns: repeat(2,1fr) !important; }
    .fp-nav-links a:not(.fp-btn3d) { display: none; }
    .fp-hero-h1 { font-size: 42px !important; }
    .fp-section-h2 { font-size: 32px !important; }
  }
  @media (max-width: 600px) {
    .fp-grid-3 { grid-template-columns: 1fr !important; }
    .fp-grid-4 { grid-template-columns: 1fr !important; }
    .fp-variants-grid { grid-template-columns: 1fr !important; }
  }
</style>

<script>
  (function () {
    if (window.__fpInit) return;
    window.__fpInit = true;

    function initReveal(root) {
      if (!('IntersectionObserver' in window)) {
        root.querySelectorAll('.fp-reveal').forEach(function (n) { n.classList.add('fp-in'); });
        return;
      }
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) { e.target.classList.add('fp-in'); io.unobserve(e.target); }
        });
      }, { threshold: 0.12 });
      root.querySelectorAll('.fp-reveal').forEach(function (n, i) {
        n.style.transitionDelay = (i % 4) * 60 + 'ms';
        io.observe(n);
      });
    }

    function initFaq(root) {
      root.querySelectorAll('[data-fp-faq]').forEach(function (faq) {
        var items = faq.querySelectorAll('[data-fp-faq-item]');
        items.forEach(function (item, i) {
          var btn = item.querySelector('[data-fp-faq-toggle]');
          var panel = item.querySelector('[data-fp-faq-panel]');
          var icon = item.querySelector('[data-fp-faq-icon]');
          btn.addEventListener('click', function () {
            var wasOpen = item.classList.contains('fp-faq-open');
            items.forEach(function (other) {
              other.classList.remove('fp-faq-open');
              other.querySelector('[data-fp-faq-panel]').style.maxHeight = '0px';
              other.querySelector('[data-fp-faq-icon]').style.transform = 'rotate(0deg)';
            });
            if (!wasOpen) {
              item.classList.add('fp-faq-open');
              panel.style.maxHeight = panel.scrollHeight + 'px';
              icon.style.transform = 'rotate(45deg)';
            }
          });
          if (i === 0) btn.click();
        });
      });
    }

    function initFilters(root) {
      root.querySelectorAll('[data-fp-filters]').forEach(function (group) {
        var chips = group.querySelectorAll('[data-fp-filter]');
        var grid = document.getElementById(group.getAttribute('data-fp-filters'));
        if (!grid) return;
        var cards = grid.querySelectorAll('[data-fp-card]');
        chips.forEach(function (chip) {
          chip.addEventListener('click', function () {
            chips.forEach(function (c) { c.classList.remove('fp-chip-active'); });
            chip.classList.add('fp-chip-active');
            var f = chip.getAttribute('data-fp-filter');
            var visible = 0;
            cards.forEach(function (card) {
              var show = f === 'toate' || card.getAttribute('data-fp-cat') === f;
              card.style.display = show ? '' : 'none';
              if (show) visible++;
            });
            var empty = grid.parentElement.querySelector('[data-fp-empty]');
            if (empty) empty.style.display = visible === 0 ? '' : 'none';
          });
        });
      });
    }

    document.addEventListener('DOMContentLoaded', function () {
      initReveal(document);
      initFaq(document);
      initFilters(document);
    });
    if (document.readyState !== 'loading') {
      initReveal(document);
      initFaq(document);
      initFilters(document);
    }
  })();
</script>
